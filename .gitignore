# ============================================================
# 装甲板检测与关键点推理 —— Git 忽略规则
#
# 作业要求：模型权重、原始视频、结果视频、虚拟环境都无需提交到 Git 历史，
# 必须通过 .gitignore 排除。以下规则覆盖这四类文件。
# 注意：docs/ 下的结果截图需要提交（README 第 6 项要求展示代表性截图）。
# ============================================================

# ---------- 模型权重 ----------
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.weights

# ---------- 视频文件（原始视频与推理结果视频作为作业附件单独提交） ----------
*.mp4
*.mov
*.avi
*.webm
*.mkv
*.flv

# ---------- Python 虚拟环境 ----------
.venv/
venv/
env/
ENV/
virtualenv/

# ---------- Python 缓存与编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.ipynb_checkpoints/
.pytest_cache/

# ---------- ultralytics 运行产物 ----------
runs/
weights/
*.cache

# ---------- 日志与临时文件 ----------
*.log
*.tmp
*.bak
~$*

# ---------- 编辑器与操作系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
